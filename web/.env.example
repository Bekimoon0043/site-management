# Supabase project settings → API
# These are required at BUILD time on Railway (set them as Variables)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Telegram bot username (without @) for "Connect Telegram" deep links
# Example: Sitemanagement_bot
VITE_TELEGRAM_BOT=YourSiteBot

# Local MS Project (.mpp) converter (tools/mpp-converter). Unset = http(s)://<same host as the page>:8787
# VITE_MPP_CONVERTER_URL=http://192.168.0.124:8787
