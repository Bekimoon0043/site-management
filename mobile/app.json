{
  "expo": {
    "name": "Site Materials",
    "slug": "site-materials",
    "scheme": "sitematerials",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#163A5F"
    },
    "android": {
      "package": "et.site.materials",
      "adaptiveIcon": {
        "backgroundColor": "#163A5F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Site Materials to take photos of deliveries, progress and damage."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Site Materials to geotag delivery and progress photos."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow biometric unlock."
        }
      ],
      "expo-notifications",
      "expo-image",
      "@react-native-vector-icons/material-design-icons",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Site Materials to scan gate pass and material QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
